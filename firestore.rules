rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInAsAdmin() {
      return request.auth != null && (
          request.auth.token.email == "roys.abreu@gmail.com"
      );
    }

    // Regla para la colección 'clientes'
    match /clientes/{id} {
      allow read, update, delete, create: if isSignedInAsAdmin();
    }

    // Regla para la colección 'registro'
    match /registro {
      allow read, update, delete, create: if isSignedInAsAdmin();
    }
    match /limpiezasMensuales/{document=**} {
       allow read, write,update,create: if isSignedInAsAdmin(); 
  }match /gastos/{id} {
  allow read, update, delete, create: if isSignedInAsAdmin();
}
    // Portal público de clientes: acceso por token (enlace único) o por
    // email verificado (login con Google). Escritura solo por el admin
    // (se rellena al guardar una factura desde el panel).
    match /facturasPublicas/{token} {
      allow get: if true;   // hace falta conocer el token exacto para leer
      allow list: if false; // nadie puede enumerar todos los clientes
      allow write: if isSignedInAsAdmin();

      // Legado: antes 'facturas' y 'firmas' vivían como subcolecciones con
      // `allow read: if true`, asumiendo que solo se podían leer conociendo
      // el token del padre. Eso era falso: Firestore evalúa las reglas de
      // subcolecciones por forma de ruta, no por cómo se llegó a ellas, así
      // que una collection-group query (`collectionGroup(db,'facturas')`)
      // podía leer los datos de TODOS los clientes sin conocer ningún
      // token. Ahora 'facturas' y 'firmas' se guardan como campos array en
      // el propio documento padre (protegido por el `allow get` de arriba,
      // que sí exige el token exacto). Estas subcolecciones solo quedan
      // para que el admin migre datos antiguos una única vez.
      match /facturas/{facturaId} {
        allow read, write: if isSignedInAsAdmin();
      }
      match /firmas/{firmaId} {
        allow read, write: if isSignedInAsAdmin();
      }
    }
    match /clientePortalTokens/{nameSlug} {
      allow read, write: if isSignedInAsAdmin();
    }
    match /clientePortalIndex/{emailSlug} {
      allow read: if request.auth != null && request.auth.token.email == resource.data.clienteEmail;
      allow write: if isSignedInAsAdmin();
    }

    match /mensajes/{document} {
      allow create: if
        request.resource.data.keys().hasAll(['nombre', 'email', 'mensaje']) &&
        request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 100 &&
        request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 200 &&
        request.resource.data.mensaje is string && request.resource.data.mensaje.size() > 0 && request.resource.data.mensaje.size() <= 2000 &&
        request.resource.data.keys().size() <= 6;
      allow read, update, delete: if isSignedInAsAdmin();
    }
  }
}