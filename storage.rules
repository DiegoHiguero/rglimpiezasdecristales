rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Firmas del portal de clientes: conocer la ruta (token único del
    // cliente) es el acceso de lectura, igual que el enlace del portal.
    // Solo el admin puede subir.
    match /firmas/{token}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "roys.abreu@gmail.com";
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null && (
        request.auth.token.email == "roys.abreu@gmail.com"
      );
    }
  }
}
